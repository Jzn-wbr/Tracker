<Window x:Class="Tracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Tracker"
        Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/favicon.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#172033" Padding="18,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" Background="#2F6FEB" CornerRadius="8">
                        <Image Width="17" Height="17" Source="pack://application:,,,/favicon.ico" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Tracker" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Productivité personnelle" Foreground="#94A3B8" FontSize="10" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,42,0,0">
                    <TextBlock Text="ESPACE DE TRAVAIL" Foreground="#8794AA" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,10" />
                    <Button Style="{StaticResource SidebarNavButton}" Tag="{Binding IsOverviewPage}" Command="{Binding ShowOverviewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" Foreground="#9EC0FF" FontSize="17" Margin="0,0,10,0" />
                            <TextBlock Text="Vue d’ensemble" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="{Binding IsHabitsPage}" Command="{Binding ShowHabitsCommand}" Style="{StaticResource SidebarNavButton}" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" Foreground="#9EC0FF" FontSize="17" Margin="0,0,10,0" />
                            <TextBlock Text="Habitudes" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border Grid.Row="2" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="ÉTAT DU SERVICE" Foreground="#8794AA" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#7C8AA3" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding AgentStatus}" Foreground="#E8EDF5" FontSize="12" />
                        </StackPanel>
                        <TextBlock Text="{Binding LastRefreshText}" Foreground="#8794AA" FontSize="11" Margin="16,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="30,28,24,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,24" Visibility="{Binding IsOverviewPage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Vue d’ensemble" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Suivez votre activité et vos habitudes numériques." Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Row="0" Panel.ZIndex="10" Content="⚙" ToolTip="Afficher ou masquer les réglages" Command="{Binding ToggleSettingsCommand}" Style="{StaticResource SecondaryButton}" Width="38" Height="34" Padding="0" FontSize="17" HorizontalAlignment="Right" VerticalAlignment="Top" />
                <StackPanel Grid.Row="0" Margin="0,0,0,24" Visibility="{Binding IsHabitsPage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Habitudes" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Compare ton usage à la semaine précédente." Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,5,0,0" />
                </StackPanel>
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20" Visibility="{Binding IsOverviewPage, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource KpiCard}" Height="104" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="AUJOURD’HUI" Style="{StaticResource CardTitle}" /><TextBlock Text="{Binding TotalToday}" Style="{StaticResource CardValue}" /><TextBlock Text="Temps total suivi" Style="{StaticResource CardSubtitle}" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Height="104" Margin="8,0">
                        <StackPanel><TextBlock Text="7 DERNIERS JOURS" Style="{StaticResource CardTitle}" /><TextBlock Text="{Binding TotalWeek}" Style="{StaticResource CardValue}" /><TextBlock Text="Temps total suivi" Style="{StaticResource CardSubtitle}" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Height="104" Margin="8,0,0,0">
                        <StackPanel><TextBlock Text="APPLICATION PRINCIPALE" Style="{StaticResource CardTitle}" /><TextBlock Text="{Binding TopAppName}" Style="{StaticResource CardValue}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding TopAppDuration}" Style="{StaticResource CardSubtitle}" /></StackPanel>
                    </Border>
                </UniformGrid>
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20" Visibility="{Binding IsHabitsPage, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource KpiCard}" Height="104" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="TEMPS TOTAL" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding Habits.CurrentTotalText}" Style="{StaticResource CardValue}" />
                            <TextBlock Text="{Binding Habits.TotalChangeText}" Foreground="{Binding Habits.TotalChangeBrush}" Style="{StaticResource CardSubtitle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Height="104" Margin="8,0">
                        <StackPanel>
                            <TextBlock Text="MOYENNE PAR JOUR" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding Habits.DailyAverageText}" Style="{StaticResource CardValue}" />
                            <TextBlock Text="{Binding Habits.DailyAverageChangeText}" Foreground="{Binding Habits.DailyAverageChangeBrush}" Style="{StaticResource CardSubtitle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Height="104" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="JOUR LE PLUS ACTIF" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding Habits.MostActiveDayText}" Style="{StaticResource CardValue}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Habits.MostActiveDayDurationText}" Style="{StaticResource CardSubtitle}" />
                                <TextBlock Text="{Binding Habits.MostActiveDayComparisonText}" Foreground="{StaticResource TextSecondary}" Style="{StaticResource CardSubtitle}" Margin="8,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Grid.Row="2" Style="{StaticResource Card}" Height="310" Margin="0,0,0,20" Visibility="{Binding IsOverviewPage, Converter={StaticResource BoolToVisibility}}">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Activité aujourd’hui" Style="{StaticResource SectionTitle}" />
                        <oxy:PlotView Grid.Row="1" Model="{Binding TimelinePlot}" Background="Transparent" BorderThickness="0" />
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}" Height="310" Margin="0,0,0,20" Visibility="{Binding IsHabitsPage, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Cette semaine vs semaine dernière" Style="{StaticResource SectionTitle}" />
                        <oxy:PlotView Grid.Row="1" Model="{Binding HabitsPlot}" Background="Transparent" BorderThickness="0" />
                    </Grid>
                </Border>
                <Grid Grid.Row="3" Height="310" Visibility="{Binding IsOverviewPage, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="Applications principales" Style="{StaticResource SectionTitle}" />
                            <oxy:PlotView Grid.Row="1" Model="{Binding TopAppsPlot}" Background="Transparent" BorderThickness="0" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="Sites principaux" Style="{StaticResource SectionTitle}" />
                            <oxy:PlotView Grid.Row="1" Model="{Binding TopSitesPlot}" Background="Transparent" BorderThickness="0" />
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="3" Height="310" Visibility="{Binding IsHabitsPage, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Ce qui a changé" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Habits.Changes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" Fill="#CBD5E1" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding CurrentDurationText}" Foreground="{StaticResource TextSecondary}" Margin="8,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding ChangeText}" Foreground="{Binding ChangeBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Ton rythme" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="DÉBUT MOYEN" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,2" />
                            <TextBlock Text="{Binding Habits.AverageStartText}" Style="{StaticResource CardValue}" FontSize="25" />
                            <TextBlock Text="{Binding Habits.AverageStartComparisonText}" Style="{StaticResource CardSubtitle}" />
                            <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,14,0,12" />
                            <TextBlock Text="FIN MOYENNE" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding Habits.AverageEndText}" Style="{StaticResource CardValue}" FontSize="25" />
                            <TextBlock Text="{Binding Habits.AverageEndComparisonText}" Style="{StaticResource CardSubtitle}" />
                            <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,14,0,12" />
                            <TextBlock Text="HEURE LA PLUS ACTIVE" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding Habits.PeakHourText}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Habits.PeakHourSubtitle}" Style="{StaticResource CardSubtitle}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="4" Text="{Binding ErrorText}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,12,0,0" />
            </Grid>
        </ScrollViewer>

        <Border Grid.Column="2" Width="248" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Padding="24,28" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Réglages" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Contrôlez ce que Tracker observe." Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,24" />
                    <TextBlock Text="SUIVI" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <CheckBox Content="Mettre le suivi en pause" IsChecked="{Binding IsPaused}" />
                    <CheckBox Content="Démarrer avec Windows" IsChecked="{Binding AutoStartEnabled}" />
                    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,8,0,20" />
                    <TextBlock Text="EXCLUSIONS" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="Applications exclues" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                    <TextBox Text="{Binding ExcludedAppsText}" AcceptsReturn="True" Height="72" Margin="0,5,0,15" TextWrapping="Wrap" />
                    <TextBlock Text="Sites exclus" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                    <TextBox Text="{Binding ExcludedSitesText}" AcceptsReturn="True" Height="72" Margin="0,5,0,20" TextWrapping="Wrap" />
                    <Button Content="Enregistrer les réglages" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="Exporter les données (CSV)" Command="{Binding ExportDataCommand}" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" HorizontalAlignment="Stretch" />
                    <Button Content="Supprimer toutes les données" Command="{Binding ClearDataCommand}" Style="{StaticResource DangerButton}" Margin="0,10,0,0" HorizontalAlignment="Stretch" />
                    <TextBlock Text="L’agent de suivi est lancé par une tâche planifiée Windows." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,22,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
