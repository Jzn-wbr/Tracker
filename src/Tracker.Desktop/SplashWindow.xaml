<Window x:Class="Tracker.Desktop.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tracker.Desktop"
        mc:Ignorable="d"
        
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False" Background="Transparent"
        Height="450" Width="800">
    
    <Grid>
        <Image Source="/Images/Splashscreen.png" Width="800" Height="450" />
        <ProgressBar IsIndeterminate="True" Width="180" Height="4" Margin="0,240,0,0"
                     Background="#14233A" Foreground="#4A90FF" BorderThickness="0"/>
    </Grid>
</Window>
